# Copy to `.env.submit` and fill in. `.env.submit` is gitignored — never commit real values.
# Used by `npm run submit` (wxt submit) to publish to the Chrome Web Store.
# How to get these: https://wxt.dev/guide/essentials/publishing.html

# Chrome Web Store item id (from the dashboard URL of your published item)
CHROME_EXTENSION_ID=
# OAuth client from Google Cloud Console (Chrome Web Store API enabled)
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
# Refresh token generated once via the OAuth flow
CHROME_REFRESH_TOKEN=
# Optional: "default" (public) or "trustedTesters"
CHROME_PUBLISH_TARGET=default
# Optional: set to "true" to upload but skip auto-submitting for review
# CHROME_SKIP_SUBMIT_REVIEW=true
